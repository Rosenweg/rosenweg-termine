[Desktop Entry]
Type=Application
Version=1.0
Name=Rosenweg Termine
Comment=Termine und Versammlungen deiner STWEG: ansehen, in den Kalender übernehmen, erinnern lassen.
Exec=rosenweg-termine
# Name im Symbol-Thema (hicolor), kein Pfad.
Icon=rosenweg-termine
Terminal=false
# Dateiname = GTK-Anwendungskennung (APPLICATION_ID in linux/CMakeLists.txt).
StartupWMClass=ch.rosenweg4303.termine
# Kategorie "Rosenweg" im Startmenue der Stationen (os-stationen 60-programme.sh)
Categories=Office;Utility;
Keywords=Rosenweg;
